@page "/clinics/{ClinicId:guid}"
@attribute [Authorize]
@inject PortalClient Portal
@inject NavigationManager Navigation
<PageTitle>Clinic details · PHCIS</PageTitle>
<a class="back-link" href="/clinics">← Back to Clinics</a>
<ApiError Error="_error" />
@if (_clinic is not null)
{
    <h1>@_clinic.Name</h1>
    <section class="clinic-details panel">
        <img src="images/clinic-exterior.png" alt="Illustrative image of a community clinic" />
        <div><h2>@_clinic.Name</h2><p><Icon Name="location" /> @_clinic.Address</p><p><Icon Name="phone" /> @_clinic.PhoneNumber</p><p><Icon Name="clock" /> Check available dates and times</p></div>
    </section>
    @if (Reschedule is not null) { <div class="notice info">Choose a new time for your appointment at this clinic.</div> }
    <AvailabilityPanel @key="ClinicId" ClinicId="ClinicId" ReviewInSeparatePage="true" OnSelected="Continue" />
}
else if (_error is null) { <p role="status">Loading clinic…</p> }
@code {
    [Parameter] public Guid ClinicId { get; set; }
    [SupplyParameterFromQuery] public Guid? Reschedule { get; set; }
    private ClinicCard? _clinic;
    private AppointmentApiException? _error;
    protected override async Task OnParametersSetAsync()
    {
        try
        {
            _clinic = (await Portal.ClinicsAsync()).FirstOrDefault(x => x.Id == ClinicId);
            if (_clinic is null) _error = new AppointmentApiException(404, "The clinic could not be found.");
        }
        catch (AppointmentApiException error) { _error = error; }
    }
    private void Continue(SlotSummary slot) => Navigation.NavigateTo(
        $"/book/{ClinicId}?slot={slot.Id}" + (Reschedule is null ? "" : $"&reschedule={Reschedule}"));
}

