{
  "ConnectionStrings": {
    "Phcis": ""
  },
  "Database": {
    "ApplyMigrationsOnStartup": true
  },
  "DatabaseLogging": { "Enabled": true },
  "Email": {
    "Enabled": false,
    "SmtpHost": "localhost",
    "SmtpPort": 1025,
    "From": "no-reply@phcis.local",
    "ReminderLeadHours": 24,
    "EnableSsl": false
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    }
  }
}
